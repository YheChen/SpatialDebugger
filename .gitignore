# Unity folder is tracked by this repo directly.
Unity/Library/
Unity/Temp/
Unity/Obj/
Unity/Build/
Unity/Builds/
Unity/Logs/
Unity/UserSettings/
Unity/MemoryCaptures/
Unity/Recordings/
Unity/*.csproj
Unity/*.sln
Unity/*.slnx
Unity/*.unityproj
Unity/*.apk
Unity/*.aab

# --- Builds / artefacts -------------------------------------------------
*.apk
*.aab
build/
dist/

