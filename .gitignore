# --- Python / backend ---------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Living scratch file for context handover between sessions. Deliberately
# untracked: it is working state, rewritten constantly, and would churn the
# history. CLAUDE_PROGRESS.md is the committed, curated record.
handover.json

# Secrets. .env.example IS committed; .env is not.
.env
.env.local
*.key

# --- Unity --------------------------------------------------------------
# Unity/.gitignore covers the rest; these are belt-and-braces because the
# Unity folder is tracked by this repo directly.
Unity/Library/
Unity/Temp/
Unity/Obj/
Unity/Build/
Unity/Builds/
Unity/Logs/
Unity/UserSettings/
Unity/MemoryCaptures/
Unity/Recordings/
Unity/*.csproj
Unity/*.sln
Unity/*.slnx
Unity/*.unityproj
Unity/*.apk
Unity/*.aab

# --- Builds / artefacts -------------------------------------------------
*.apk
*.aab
build/
dist/

# Unity writes an IL2CPP symbol/assembly backup next to every player build.
# It is hundreds of megabytes and must never be committed. The name depends on
# the product name and on where the Build Profile points, so match the suffix.
*_BackUpThisFolder_ButDontShipItWithYourGame/
# A Windows-style build path typed into the Build dialog lands as a literal
# colon-separated folder name inside Unity/.
Unity/*:Builds:*

# --- macOS / editors ----------------------------------------------------
.DS_Store
.idea/
*.swp
