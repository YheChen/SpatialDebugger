# Copy to .env and edit. EVERY value here is optional -- the service runs
# fully offline with deterministic demo responses if you set nothing.

# mock | openai
SPATIALDEBUGGER_PROVIDER=mock

# If a live provider errors, fall back to the offline scenarios instead of
# returning an error into the headset. Leave this on for the demo.
SPATIALDEBUGGER_FALLBACK_TO_MOCK=true

SPATIALDEBUGGER_HOST=0.0.0.0
SPATIALDEBUGGER_PORT=8000
SPATIALDEBUGGER_CORS_ORIGINS=*
SPATIALDEBUGGER_TIMEOUT=20

# --- Optional: OpenAI reasoning -------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Optional: Huawei OMNI perception -------------------------------------
# OMNI_API_KEY=...
# OMNI_ENDPOINT=https://...
